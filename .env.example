# ========= F1Z PRIME — environment =========
# Copy to .env and fill in. Never commit .env.

# development | production
ENVIRONMENT=production
# Test user without Telegram + test payments. Forcibly OFF when ENVIRONMENT=production.
DEV_MODE=false

# --- Domain / HTTPS (Caddy gets a Let's Encrypt certificate automatically) ---
SITE_ADDRESS=shop.example.com
WEBAPP_URL=https://shop.example.com
CORS_ORIGINS=https://shop.example.com

# --- Telegram ---
# Token from @BotFather
BOT_TOKEN=
BOT_USERNAME=f1z_prime_bot
# Telegram IDs that receive notifications about orders/payments/tickets (comma separated)
ADMIN_TELEGRAM_IDS=

# --- Database ---
POSTGRES_DB=f1z
POSTGRES_USER=f1z
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Security ---
# openssl rand -hex 32
SECRET_KEY=
ADMIN_USERNAME=admin
# Preferred: hash generated with
#   docker compose run --rm api python -c "from app.security import hash_password; print(hash_password('YOUR_PASSWORD'))"
ADMIN_PASSWORD_HASH=
# Or plain password (min 10 chars in production) — use only if no hash is set
ADMIN_PASSWORD=
ADMIN_TOKEN_TTL_HOURS=12

# --- Behaviour ---
INIT_DATA_TTL_SECONDS=86400
ORDER_TTL_MINUTES=30
MAX_PENDING_ORDERS=5
SEED_ON_START=true
# Demo premium numbers for presentations. Keep false for real sales.
SEED_DEMO_PREMIUM=false
LOG_LEVEL=INFO
