{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Admin panel (SPA, served under /admin)
	handle_path /admin* {
		root * /srv/admin
		header X-Frame-Options "DENY"
		header X-Robots-Tag "noindex, nofollow"
		# hashed bundles are immutable; index.html must always be revalidated so a deploy is picked up
		@adminassets path /assets/*
		header @adminassets Cache-Control "public, max-age=31536000, immutable"
		@adminpage not path /assets/*
		header @adminpage Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Telegram Mini App (SPA). Telegram embeds it in an iframe on web clients — no X-Frame-Options here.
	handle {
		root * /srv/miniapp
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
